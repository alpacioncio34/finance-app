# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# Database connection string (default: local SQLite file in backend/)
DATABASE_URL=sqlite:///./finance.db

# Secret used to sign login tokens. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Token lifetime in minutes
JWT_EXPIRE_MINUTES=60
