# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# Database connection string (default: local SQLite file in backend/)
DATABASE_URL=sqlite:///./finance.db

# Secret used to sign login tokens. At least 32 characters, or the API refuses to start.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime in minutes. Keep it short: the app renews it with the refresh token.
JWT_EXPIRE_MINUTES=15
# Refresh token lifetime in days. This is how long a user stays logged in without typing the password.
REFRESH_EXPIRE_DAYS=30

# Web origins allowed to call the API, comma-separated. "*" is for local development only.
CORS_ORIGINS=*

# ---- Bank sync ----
# Which bank data provider to use. "sandbox" is a fake bank with made-up data (no credentials needed).
# "none" turns bank sync off.
BANK_PROVIDER=sandbox
# Key that encrypts stored bank tokens. If empty, one is derived from JWT_SECRET (fine for local use).
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANK_TOKEN_KEY=
# Where a bank may send the user back to: app schemes and web origins, comma-separated.
BANK_REDIRECT_ALLOWLIST=financeapp,exp,http://localhost,http://127.0.0.1
